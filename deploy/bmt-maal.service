[Unit]
Description=BMT Keuangan Maal Flask App
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/bmt-maal
Environment="SECRET_KEY=MaalBmt@2026!"
# LAPORAN_API_KEY: token autentikasi endpoint /api/laporan-harian (dibaca agen laporan harian).
# Ganti nilainya dengan token acak yang sama di /etc/bmt-sync.env (MAAL_API_KEY) di VPS billing.
# Contoh generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
Environment="LAPORAN_API_KEY=GANTI_DENGAN_TOKEN_ACAK"
ExecStart=/var/www/bmt-maal/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5001 \
    --timeout 60 \
    --access-logfile /var/log/bmt-maal/access.log \
    --error-logfile /var/log/bmt-maal/error.log \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
